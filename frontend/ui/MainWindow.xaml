<Window x:Class="ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ui"
        xmlns:viewmodels="clr-namespace:ui.ViewModels"
        mc:Ignorable="d"
        Title="ISMS-P 자동 취약점 진단 결과 분석 및 보고서 생성기" 
        Height="780" Width="1280"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveGuidelinesCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Navigation -->
            <ColumnDefinition Width="280"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- LEFT SIDEBAR                               -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- App Title / Logo -->
                    <RowDefinition Height="70"/>
                    <!-- Nav Tabs -->
                    <RowDefinition Height="Auto"/>
                    <!-- Separator -->
                    <RowDefinition Height="Auto"/>
                    <!-- Target Host List Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Target Host List -->
                    <RowDefinition Height="*"/>
                    <!-- Load File Button -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title / Logo Area -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <!-- Shield Icon (Path) -->
                    <Path Data="M 12 2 L 2 5 L 2 11 C 2 17.5 6.3 23.5 12 25 C 17.7 23.5 22 17.5 22 11 L 22 5 Z" 
                          Fill="{StaticResource AccentBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="ISMS-P Analyzer" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="취약점 분석 및 보고서 생성" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Row="1" Margin="8,10,8,10">
                    <!-- Dashboard Nav Button -->
                    <Button Command="{Binding SelectViewCommand}" CommandParameter="Dashboard" Content="대시보드" Margin="0,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedView}" Value="Dashboard">
                                        <Setter Property="Background" Value="#252526"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

					<!-- Guideline Manager Nav Button -->
					<Button Command="{Binding SelectViewCommand}" CommandParameter="GuidelineManager" Content="조치 가이드 관리" Margin="0,2">
						<Button.Style>
							<Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding SelectedView}" Value="GuidelineManager">
										<Setter Property="Background" Value="#252526"/>
										<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
										<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
										<Setter Property="BorderThickness" Value="4,0,0,0"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
					</Button>

                    <!-- Detailed Results Nav Button -->
                    <Button Command="{Binding SelectViewCommand}" CommandParameter="DetailedResults" Content="진단결과 상세분석" Margin="0,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedView}" Value="DetailedResults">
                                        <Setter Property="Background" Value="#252526"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Report Generator Nav Button -->
                    <Button Command="{Binding SelectViewCommand}" CommandParameter="ReportGenerator" Content="보고서 내보내기" Margin="0,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedView}" Value="ReportGenerator">
                                        <Setter Property="Background" Value="#252526"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Separator Grid.Row="2" Background="{StaticResource BorderBrush}" Margin="15,0"/>

                <!-- Host List Header -->
                <TextBlock Grid.Row="3" Text="진단 대상 호스트 목록" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,15,20,5"/>

                <!-- Target Host List -->
                <ListBox Grid.Row="4" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" Margin="8,5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- OS Indicator Icon -->
                                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" Background="#2C2C2C" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="W" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SystemInfo.TargetOs}" Value="Windows">
                                                        <Setter Property="Text" Value="W"/>
                                                        <Setter Property="Foreground" Value="#00A4EF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SystemInfo.TargetOs}" Value="Linux">
                                                        <Setter Property="Text" Value="L"/>
                                                        <Setter Property="Foreground" Value="#FCC624"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Hostname and IP -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SystemInfo.Hostname}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding SystemInfo.IpAddress}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Delete button -->
                                <Button Grid.Column="2" 
                                        Command="{Binding DataContext.RemoveReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"
                                        VerticalAlignment="Center">
                                    <Path Data="M 19 6.41 L 17.59 5 L 12 10.59 L 6.41 5 L 5 6.41 L 10.59 12 L 5 17.59 L 6.41 19 L 12 13.41 L 17.59 19 L 19 17.59 L 13.41 12 Z" 
                                          Fill="#D32F2F" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Load File Button -->
                <Button Grid.Row="5" Command="{Binding LoadFilesCommand}" Content="진단 파일 로드 (.json)" Style="{StaticResource SecondaryButtonStyle}" Margin="16,10,16,20"/>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN CONTENT AREA                          -->
        <!-- ========================================== -->
        <Grid Grid.Column="1" Margin="24">
            
            <!-- 1. DASHBOARD VIEW -->
            <Grid x:Name="DashboardPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedView}" Value="Dashboard">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Title -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="보안 진단 대시보드" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="불러온 JSON 파일들을 종합 분석하여 보안 취약점 상태를 진단합니다." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Summary Stats Cards Row -->
                <Grid Grid.Row="1" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Total Hosts -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="진단 호스트 수" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalHosts}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="대 가상/물리 머신" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Total Check Items -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="총 점검 항목 수" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalItems}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="개 보안 점검 완료" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Pass Rate -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="양호율 (Pass Rate)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PassRate, StringFormat={}{0}%}" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom"/>
                            </Grid>
                            
                            <!-- Custom Progress Bar -->
                            <ProgressBar Value="{Binding PassRate}" Maximum="100" Height="4" Background="#333333" Foreground="{StaticResource PassBrush}" BorderThickness="0" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Pass/Fail Breakdown -->
                    <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="보안 취약점 분포" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                                <Grid Margin="0,2">
                                    <TextBlock Text="● 양호 (Pass)" Foreground="{StaticResource PassBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding TotalPass}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="● 취약 (Fail)" Foreground="{StaticResource FailBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding TotalFail}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="● 해당 없음 (N/A)" Foreground="{StaticResource NaBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding TotalNa}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Detailed Host Status List -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="호스트별 진단 상태 요약" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                        <!-- Host Statistics Grid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Reports}" Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="OS" Binding="{Binding SystemInfo.TargetOs}" Width="100"/>
                                <DataGridTextColumn Header="호스트명" Binding="{Binding SystemInfo.Hostname}" Width="*"/>
                                <DataGridTextColumn Header="IP 주소" Binding="{Binding SystemInfo.IpAddress}" Width="150"/>
                                <DataGridTextColumn Header="진단일시" Binding="{Binding SystemInfo.InspectionDate}" Width="150"/>
                                <DataGridTemplateColumn Header="동작" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="상세 분석" Style="{StaticResource FlatButtonStyle}" Padding="8,4" FontSize="11" 
                                                    Command="{Binding DataContext.SelectViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="DetailedResults"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. DETAILED RESULTS VIEW -->
            <Grid x:Name="DetailedResultsPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedView}" Value="DetailedResults">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Filter and Search -->
                    <RowDefinition Height="Auto"/>
                    <!-- List and Details Split -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Title -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="진단 결과 상세 분석" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="각 항목별 진단 상태, 근거 확인 및 ISMS-P 기준 기술적 조치 방안을 상세히 확인합니다." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Search and Filters -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="호스트 선택: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" Height="32" VerticalContentAlignment="Center" Background="#F5F5F5" Foreground="Black" BorderBrush="{StaticResource BorderBrush}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SystemInfo.Hostname}" Foreground="Black"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="상태 필터: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="20,0,8,0"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Height="32" VerticalContentAlignment="Center" Background="#F5F5F5" Foreground="Black" BorderBrush="{StaticResource BorderBrush}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="Black"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Search Input -->
                    <Grid Grid.Column="4" Margin="20,0,0,0" HorizontalAlignment="Right" Width="250">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="8,4" Height="32" Background="#252526" Foreground="White" BorderBrush="{StaticResource BorderBrush}"/>
                        <TextBlock Text="검색 (코드, 항목명, 내용)..." Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <!-- List & Inspector Details (Columns Split) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <!-- List -->
                        <ColumnDefinition Width="3*"/>
                        <!-- Grid Splitter -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Inspector Details -->
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Diagnostics List -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="0">
                        <DataGrid ItemsSource="{Binding FilteredDiagnostics}" SelectedItem="{Binding SelectedDiagnosticItem}" BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="70"/>
                                <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="100"/>
                                <DataGridTextColumn Header="진단 항목명" Binding="{Binding Title}" Width="*"/>
                                <DataGridTemplateColumn Header="중요도" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="High">
                                                                <Setter Property="Background" Value="#33E81123"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                                <Setter Property="Background" Value="#33FF8C00"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Low">
                                                                <Setter Property="Background" Value="#338A8886"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Severity}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="High">
                                                                    <Setter Property="Foreground" Value="#FF4D4D"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                                    <Setter Property="Foreground" Value="#FFA500"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Low">
                                                                    <Setter Property="Foreground" Value="#D0D0D0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="상태" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                                <Setter Property="Background" Value="{StaticResource PassBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                                <Setter Property="Background" Value="{StaticResource FailBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="N/A">
                                                                <Setter Property="Background" Value="{StaticResource NaBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <!-- Right: Inspector Pane (Fixed single-child nested Border issue) -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                        <Grid>
                            <!-- Grid 1: Details Pane -->
                            <Grid DataContext="{Binding SelectedDiagnosticItem}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.RowDefinitions>
                                    <!-- Basic Info -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Description -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Evidence -->
                                    <RowDefinition Height="*"/>
                                    <!-- Remediation -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Basic Info -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                    <Grid>
                                        <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap">
                                            <Run Text="["/><Run Text="{Binding Code}"/><Run Text="] "/><Run Text="{Binding Title}"/>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="분류: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Margin="0,0,20,0"/>

                                        <TextBlock Text="진단결과: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" Margin="0,0,20,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                            <Setter Property="Foreground" Value="{StaticResource PassBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                            <Setter Property="Foreground" Value="{StaticResource FailBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="N/A">
                                                            <Setter Property="Foreground" Value="{StaticResource NaBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Description -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                                    <TextBlock Text="점검 내용 및 위험" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <Border Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
                                    </Border>
                                </StackPanel>

                                <!-- Evidence -->
                                <Grid Grid.Row="2" Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="진단 판단 근거 (Evidence)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <Border Grid.Row="1" Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding Evidence}" BorderThickness="0" Background="Transparent" Foreground="#85E885" 
                                                     FontFamily="Consolas, Courier New" FontSize="11" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>

                                <!-- Remediation -->
                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="기술적 조치 및 가이드라인 (Remediation)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <Border Grid.Row="1" Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding Remediation}" BorderThickness="0" Background="Transparent" Foreground="#FFD580" 
                                                     FontFamily="Consolas, Courier New" FontSize="11" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Grid 2: Empty State Pane -->
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDiagnosticItem}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 13 17 H 11 V 15 H 13 V 17 Z M 13 13 H 11 V 7 H 13 V 13 Z" 
                                          Fill="{StaticResource TextMutedBrush}" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="상세 내역을 확인할 진단 항목을 선택하세요." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. REPORT GENERATOR VIEW -->
            <Grid x:Name="ReportGeneratorPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedView}" Value="ReportGenerator">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Config Panels -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Title -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="진단 보고서 생성 및 내보내기" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="분석 완료된 데이터를 취약점 진단 조치 계획서, 요약본 등 다양한 양식의 엑셀/PDF 보고서로 내보냅니다." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Main config -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Form Settings -->
                        <ColumnDefinition Width="1*"/>
                        <!-- Output Log console -->
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Settings Column -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <!-- Step 1: Template Choices -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="1. 내보낼 보고서 유형 선택" FontSize="14" FontWeight="Bold" Margin="0,0,0,16"/>

                                <CheckBox IsChecked="{Binding ExportDetailReport}" Margin="0,6" VerticalContentAlignment="Center">
                                    <TextBlock Text="상세 결과 보고서 (.xlsx)" FontSize="12" Margin="5,0,0,0"/>
                                </CheckBox>
                                <TextBlock Text="  - 개별 항목별 상세 진단 결과, 증적 코드 및 가이드 포함" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="20,0,0,8"/>

                                <CheckBox IsChecked="{Binding ExportSummaryReport}" Margin="0,6" VerticalContentAlignment="Center">
                                    <TextBlock Text="위험관리 계획서 (.xlsm)" FontSize="12" Margin="5,0,0,0"/>
                                </CheckBox>
                                <TextBlock Text="  - 자산별 위험 통제 계획 및 조치 상태 포함" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="20,0,0,8"/>

                                <CheckBox IsChecked="{Binding ExportActionPlan}" Margin="0,6" VerticalContentAlignment="Center">
                                    <TextBlock Text="위험 분석 평가표 (.xlsm)" FontSize="12" Margin="5,0,0,0"/>
                                </CheckBox>
                                <TextBlock Text="  - 자산별 위험 분석 평가 및 중요도 산출 결과 포함" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="20,0,0,8"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 2: Integrated Settings -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="2. 파일 출력 구성" FontSize="14" FontWeight="Bold" Margin="0,0,0,16"/>

                                <CheckBox IsChecked="{Binding IntegrateHosts}" Margin="0,6" VerticalContentAlignment="Center">
                                    <TextBlock Text="선택한 모든 호스트의 결과를 하나의 엑셀에 통합 출력" FontSize="12" Margin="5,0,0,0"/>
                                </CheckBox>
                                <TextBlock Text="  - 해제 시 호스트별로 별도의 보고서 파일이 생성됩니다." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="20,0,0,8"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 3: Destination -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="3. 저장 경로 지정" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ExportPath}" VerticalContentAlignment="Center" Padding="8,4" Height="32" Background="#161616" Foreground="White" BorderBrush="{StaticResource BorderBrush}"/>
                                    <Button Grid.Column="1" Command="{Binding SelectExportPathCommand}" Content="경로 선택" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Height="32" Padding="12,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Output Log Column -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="16,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="생성 작업 로그" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                            
                            <!-- Terminal styled Log Box -->
                            <TextBox Grid.Row="1" Text="{Binding ExportLogs}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" 
                                     Background="#121212" Foreground="#85E885" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     FontFamily="Consolas, Courier New" FontSize="11" Padding="10"/>

                            <!-- Progress Bar -->
                            <ProgressBar Grid.Row="2" Value="{Binding ExportProgress}" Maximum="100" Height="8" Background="#333333" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Margin="0,16,0,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>

                            <!-- Big Trigger Button -->
                            <Button Grid.Row="3" Command="{Binding ExportReportCommand}" Content="보고서 파일 일괄 생성 시작" 
                                    Height="45" FontSize="14" Margin="0,16,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Content" Value="보고서 생성 중... 잠시만 기다려주세요"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. GUIDELINE MANAGER VIEW -->
            <Grid x:Name="GuidelineManagerPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedView}" Value="GuidelineManager">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Filter and Search -->
                    <RowDefinition Height="Auto"/>
                    <!-- List and Details Split -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Title -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="조치 가이드 및 상황별 멘트 관리" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="주요정보통신기반시설 점검 가이드라인 및 결과 상태(양호, 취약)별 U열 증적에 들어갈 멘트를 커스텀 편집합니다. (Ctrl + S 저장)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- OS Filter -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="운영체제(OS) 종류: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding GuidelineOsTypes}" SelectedItem="{Binding SelectedGuidelineOs}" Height="32" VerticalContentAlignment="Center" Background="#F5F5F5" Foreground="Black" BorderBrush="{StaticResource BorderBrush}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="Black"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- List & Editor Pane (Columns Split) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <!-- List -->
                        <ColumnDefinition Width="2*"/>
                        <!-- Grid Splitter -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Editor -->
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Guidelines List -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="0">
                        <DataGrid ItemsSource="{Binding FilteredGuidelines}" SelectedItem="{Binding SelectedGuidelineItem}" BorderThickness="0" Background="Transparent" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="점검 항목명" Binding="{Binding Title}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <!-- Right: Editor Pane -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                        <Grid>
                            <!-- Details Form -->
                            <Grid DataContext="{Binding SelectedGuidelineItem}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.RowDefinitions>
                                    <!-- Header Info -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Remediation Guide -->
                                    <RowDefinition Height="1.5*"/>
                                    <!-- Pass Comment -->
                                    <RowDefinition Height="1*"/>
                                    <!-- Fail Comment -->
                                    <RowDefinition Height="1*"/>
                                    <!-- Save Button -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header Info -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}">
                                        <Run Text="["/><Run Text="{Binding Code}"/><Run Text="] "/><Run Text="{Binding Title}"/>
                                    </TextBlock>
                                    <TextBlock Text="* 이 가이드라인과 멘트는 보고서 생성 시 실시간 주입되어 엑셀 결과로 추출됩니다." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Remediation TextBox -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="기술적 조치 및 가이드라인 (Remediation)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1" Text="{Binding Remediation, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                             Background="#161616" Foreground="#FFD580" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" FontFamily="Consolas, Malgun Gothic" FontSize="12"/>
                                </Grid>

                                <!-- PassComment TextBox -->
                                <Grid Grid.Row="2" Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="양호(Pass) 판정 시 점검현황 기입 멘트 (U열 주입)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1" Text="{Binding PassComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                             Background="#161616" Foreground="#85E885" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" FontFamily="Consolas, Malgun Gothic" FontSize="12"/>
                                </Grid>

                                <!-- FailComment TextBox -->
                                <Grid Grid.Row="3" Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="취약(Fail) 판정 시 점검현황 기입 멘트 (U열 주입)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1" Text="{Binding FailComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                             Background="#161616" Foreground="#FF8585" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" FontFamily="Consolas, Malgun Gothic" FontSize="12"/>
                                </Grid>

                                <!-- Save Button -->
                                <Button Grid.Row="4" Command="{Binding DataContext.SaveGuidelinesCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        Content="가이드라인 및 멘트 저장 (Ctrl + S)" Style="{StaticResource FlatButtonStyle}" Height="38" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- Empty State -->
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGuidelineItem}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 13 17 H 11 V 15 H 13 V 17 Z M 13 13 H 11 V 7 H 13 V 13 Z" 
                                          Fill="{StaticResource TextMutedBrush}" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="편집할 진단 항목을 목록에서 선택하세요." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>
